<UserControl x:Class="PositionMonitor.App.Controls.ControlPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="下行控制" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <ScrollViewer x:Name="FormScroll" Grid.Row="1" MaxHeight="500" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
      <Border Background="#F0F7F6" CornerRadius="6" Padding="10"><StackPanel><TextBlock x:Name="ControlTargetText" Text="{Binding ControlTargetTitle}" ToolTip="{Binding ControlTargetTooltip}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="命令发送到当前选择的目标" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
      <TextBlock Text="操作" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
      <ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="InputChanged" MinHeight="36" FontSize="12"><ComboBoxItem Content="查询终端信息"/><ComboBoxItem Content="查询上报周期"/><ComboBoxItem Content="设置上报周期"/><ComboBoxItem Content="重启终端"/><ComboBoxItem Content="设置功率与频点"/><ComboBoxItem Content="设置加速度量程"/><ComboBoxItem Content="远程唤醒"/></ComboBox>
      <StackPanel x:Name="PeriodPanel" Margin="0,12,0,0"><TextBlock Text="上报周期（2～259200 秒）" Style="{StaticResource Caption}"/><TextBox x:Name="PeriodBox" Text="14400" Margin="0,6,0,0" TextChanged="InputChanged"/></StackPanel>
      <StackPanel x:Name="RadioPanel" Margin="0,12,0,0"><TextBlock Text="功率（-16～22 dBm）" Style="{StaticResource Caption}"/><TextBox x:Name="PowerBox" Text="10" Margin="0,6,0,10" TextChanged="InputChanged"/><TextBlock Text="频点（0～200，逗号分隔，最多 8 个）" Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBox x:Name="FrequenciesBox" Text="160,161,162" Margin="0,6,0,0" TextChanged="InputChanged"/></StackPanel>
      <StackPanel x:Name="RangePanel" Margin="0,12,0,0"><TextBlock Text="加速度计量程" Style="{StaticResource Caption}"/><ComboBox x:Name="RangeBox" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="InputChanged"><ComboBoxItem Content="±2 g"/><ComboBoxItem Content="±4 g"/><ComboBoxItem Content="±8 g"/><ComboBoxItem Content="±16 g"/></ComboBox></StackPanel>
      <CheckBox x:Name="WakeFirst" Content="先唤醒，再发送终端命令" FontSize="12" Margin="0,12,0,0" Checked="InputChanged" Unchecked="InputChanged"/>
      <StackPanel x:Name="PagingPanel" Margin="0,12,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="唤醒频点" Style="{StaticResource Caption}"/><TextBox x:Name="WakeFrequencyBox" Text="160" Margin="0,6,0,0" TextChanged="InputChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="唤醒组号" Style="{StaticResource Caption}"/><TextBox x:Name="WakeIdBox" Text="30" Margin="0,6,0,0" TextChanged="InputChanged"/><TextBlock x:Name="WakeIdDisplay" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
        <TextBlock Text="持续时间（至少 2500 毫秒）" Style="{StaticResource Caption}" Margin="0,10,0,6"/><TextBox x:Name="WakeTimeBox" Text="5000" TextChanged="InputChanged"/>
        <TextBlock Text="512 符号 / 扩展模式 1。频点与组号需匹配终端，同组终端可能一起唤醒。" FontSize="11" TextWrapping="Wrap" Foreground="#8D5D0C" Margin="0,10,0,0"/>
      </StackPanel>
      <TextBlock Text="发送预览" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
      <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" Height="164" Padding="6" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"/>
      <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,10" Foreground="#8D5D0C"/>
      <Button x:Name="SendButton" Content="发送命令" Style="{StaticResource Primary}" Click="SendClick"/>
    </StackPanel></ScrollViewer>
      <TabControl x:Name="HistoryTabs" Grid.Row="2" Background="White" BorderThickness="0" Margin="0,14,8,0">
        <TabItem Header="执行记录" Padding="10,8"><ListBox ItemsSource="{Binding OperationsView}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="2,10" ToolTip="{Binding IdentifierTooltip}"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Time}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
        <TabItem Header="下行报文" Padding="10,8"><Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="6"/><RowDefinition Height="3*"/></Grid.RowDefinitions><ListBox ItemsSource="{Binding DownstreamView}" SelectedItem="{Binding SelectedDownlinkLog}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,5"><TextBlock Text="{Binding Name}" FontSize="12"/><TextBlock Text="{Binding Result}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource Line}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/><TextBox x:Name="DownlinkDetailBox" Grid.Row="2" Text="{Binding DownlinkDetail, Mode=OneWay}" ToolTip="{Binding SelectedDownlinkLog.IdentifierTooltip}" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Padding="6"/></Grid></TabItem>
      </TabControl>
      <TextBlock Grid.Row="3" Text="预览序号仅为示例；超时不自动重发。" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,8,0"/>
  </Grid>
</UserControl>
