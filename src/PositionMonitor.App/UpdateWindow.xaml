<Window x:Class="PositionMonitor.App.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="检查更新" Icon="Assets/PositionMonitor.ico" Width="660" Height="590" MinWidth="540" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="应用更新" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="从 GitHub Release 获取正式版本" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/></StackPanel>
    <Border Grid.Row="1" Background="#E2F1EC" CornerRadius="7" Padding="14" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="VersionText" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="ReleaseText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Grid.Row="2" Background="White" CornerRadius="7" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" Text="点击检查更新，查看新版本及更新内容。" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Top"/></ScrollViewer></Border>
    <StackPanel Grid.Row="3" Margin="0,16,0,14"><ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/><TextBlock x:Name="StatusText" Text="尚未检查" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
    <DockPanel Grid.Row="4"><Button x:Name="ReleaseButton" Content="发布页" Click="ReleaseClick" Padding="12,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="关闭" Click="CancelClick" Padding="12,8" Margin="8,0,0,0"/><Button x:Name="CheckButton" Content="重新检查" Click="CheckClick" Padding="12,8" Margin="8,0,0,0"/><Button x:Name="InstallButton" Content="下载并安装" Click="InstallClick" Style="{StaticResource Primary}" IsEnabled="False" Padding="12,8" Margin="8,0,0,0"/></StackPanel></DockPanel>
  </Grid>
</Window>
