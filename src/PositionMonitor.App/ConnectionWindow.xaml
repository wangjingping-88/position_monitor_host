<Window Style="{StaticResource AppWindow}" x:Class="PositionMonitor.App.ConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="连接设置" Width="620" Height="790" MinHeight="650" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="连接 MQTT 服务器" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="连接成功后自动订阅设备上报，断线后自动恢复。" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="服务器地址" Margin="0,0,0,6"/><TextBox x:Name="HostBox" AutomationProperties.Name="服务器地址"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="端口" Margin="0,0,0,6"/><TextBox x:Name="PortBox" AutomationProperties.Name="端口"/></StackPanel></Grid>
      <CheckBox x:Name="TlsBox" Content="使用 TLS，验证服务器证书" Checked="TlsChanged" Unchecked="TlsChanged"/>
      <Grid Margin="0,4,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="用户名（可选）" Margin="0,0,0,6"/><TextBox x:Name="UserBox" AutomationProperties.Name="用户名"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="密码（可选）" Margin="0,0,0,6"/><PasswordBox x:Name="PasswordInput" AutomationProperties.Name="密码"/></StackPanel></Grid>
      <CheckBox x:Name="RememberBox" Content="记住密码，保存到 Windows 凭据管理器" Margin="0,0,0,14"/>
      <TextBlock Text="客户端 ID" Margin="0,0,0,6"/><TextBox x:Name="ClientBox" Margin="0,0,0,14" AutomationProperties.Name="客户端 ID"/>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="公司前缀" Margin="0,0,0,6"/><TextBox x:Name="CompanyBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="网关 ID（+ 表示全部）" Margin="0,0,0,6"/><TextBox x:Name="GatewayBox" TextChanged="GatewayIdChanged"/><TextBlock x:Name="GatewayIdDisplay" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="AddTopicButton" Grid.Column="3" Content="添加主题" Click="GenerateClick" VerticalAlignment="Top" Margin="10,26,0,0" ToolTip="将当前公司、网关的主题添加到订阅列表，保留已有主题"/></Grid></Border>
      <TextBlock Text="订阅主题（每行一个）" Margin="0,14,0,6"/><TextBox x:Name="TopicBox" AutomationProperties.Name="订阅主题，每行一个" AcceptsReturn="True" Height="106" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><TextBlock Text="可同时订阅多个网关或公司；支持 + / #，自动忽略空行与重复项。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="订阅 QoS" Margin="0,0,0,6"/><ComboBox x:Name="QosBox"><ComboBoxItem Content="QoS 0"/><ComboBoxItem Content="QoS 1"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="载荷格式" Margin="0,0,0,6"/><ComboBox x:Name="ModeBox"><ComboBoxItem Content="自动：网关 JSON / Hex / 二进制"/><ComboBoxItem Content="直接透传：二进制"/><ComboBoxItem Content="直接透传：Hex 文本"/></ComboBox></StackPanel></Grid>
      <CheckBox x:Name="AckBox" Content="自动确认注册与要求响应的数据上报" Margin="0,16,0,8"/>
      <TextBlock Text="直接透传回执主题（可选）" Margin="0,5,0,6"/><TextBox x:Name="ReplyBox"/><TextBlock Text="网关封装自动按 src 路由回执。直接透传以每个上行主题识别设备；只有明确配置回执主题才会应答。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,14"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="ErrorText" Foreground="#B34332" TextWrapping="Wrap" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存设置" Click="SaveClick" Margin="0,0,8,0"/><Button Content="保存并连接" Style="{StaticResource Primary}" Click="ConnectClick" IsDefault="True"/></StackPanel></StackPanel>
  </Grid>
</Window>
