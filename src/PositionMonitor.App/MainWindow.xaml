<Window Style="{StaticResource AppWindow}" x:Class="PositionMonitor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PositionMonitor.App.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="倾角定位监测仪" Icon="Assets/PositionMonitor.ico" Width="1580" Height="940" MinWidth="1060" MinHeight="720" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="1,40,1,1" CornerRadius="0" UseAeroCaptionButtons="True"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="InformationLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Box" Padding="10,12" Background="#F1F6F7" CornerRadius="6" BorderThickness="1" BorderBrush="#DCE8EB"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#95C9C0"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#E2F1EC"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="WindowContent">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid x:Name="CaptionLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="NativeCaptionColumn" Width="138"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="3" Background="White"/>
        <Border x:Name="NativeCaptionFill" Grid.Column="3" Background="White" Height="32" VerticalAlignment="Bottom"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Border Background="{StaticResource Accent}" CornerRadius="9" Width="40" Height="40" Margin="0,0,12,0" ToolTip="倾角定位监测仪" AutomationProperties.Name="倾角定位监测仪"><TextBlock Text="∠" Foreground="White" FontFamily="Segoe UI" FontSize="28" HorizontalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="倾角定位监测仪" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="网关与终端分层查看，上下行独立操作" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></StackPanel>
        <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="SettingsButton" Content="连接设置" Click="SettingsClick" IsEnabled="{Binding CanOperate}" Padding="12,8" Margin="0,0,6,0"/>
          <Button x:Name="ConnectButton" Content="{Binding ConnectLabel}" Click="ConnectClick" Style="{StaticResource Primary}" IsEnabled="{Binding CanOperate}" Padding="12,8" Margin="0,0,6,0"/>
          <Border Background="{Binding StatusBackground}" MinWidth="92" CornerRadius="10" Padding="10,6" Margin="0,0,6,0"><TextBlock Text="{Binding ShortStatus}" Foreground="{Binding StatusForeground}" HorizontalAlignment="Center"/></Border>
          <Button x:Name="UpdateButton" Content="检查更新" Click="UpdateClick" IsEnabled="{Binding CanOperate}" Padding="12,8" Margin="0,0,6,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#F3F7F9"/>
    <Grid Grid.Row="1" Margin="14,14,14,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="8"/><ColumnDefinition Width="156"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="302"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" Padding="10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="2,0,0,12"><TextBlock Text="网关" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding GatewayCount}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
          <Grid Grid.Row="1">
            <TextBlock Text="等待网关消息&#10;连接后自动发现" Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="23" Visibility="{Binding NoGatewaysVisibility}"/>
            <ListBox x:Name="GatewayList" ItemsSource="{Binding Gateways}" SelectedItem="{Binding SelectedGateway}" ItemContainerStyle="{StaticResource NavigationItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate><DataTemplate><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PrimaryLabel}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentifierTooltip}"/><Border Grid.Column="1" Background="#EDF4F5" CornerRadius="4" Height="20" Width="24" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="{Binding ListNumber, StringFormat='网关序号 {0}'}"><TextBlock x:Name="GatewayNumberBadge" Text="{Binding ListNumber}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                <TextBlock Text="{Binding Company}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="32" Height="34"><controls:HeartbeatBadge Count="{Binding Heartbeats}"/></Viewbox><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Heartbeats}" Foreground="#B64056" FontSize="20"/><TextBlock Text="累计心跳" Foreground="#AD7380" FontSize="10"/></StackPanel></Grid>
                <TextBlock Text="{Binding HeartbeatText}" FontSize="10" Foreground="#AD7380" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding DeviceCountText}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,7,0,0"/>
              </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <StackPanel Grid.Row="2" Margin="2,12,0,0"><TextBlock Text="{Binding ModeLabel}" FontSize="11"/><TextBlock Text="{Binding Subscription}" ToolTip="{Binding Settings.Topic}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="2,0,0,12"><TextBlock Text="终端" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGatewayTitle}" ToolTip="{Binding SelectedGatewayTooltip}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/><TextBlock Text="{Binding DeviceListCaption}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="DeviceSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" TextAlignment="Center" Padding="5,8" FontSize="12" AutomationProperties.Name="搜索终端地址"/><TextBlock Text="搜索终端地址" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <Grid Grid.Row="2">
            <TextBlock Text="此网关暂无终端&#10;等待注册或在线事件" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="23" Visibility="{Binding NoDevicesVisibility}"/>
            <ListBox x:Name="DeviceList" ItemsSource="{Binding DevicesView}" SelectedItem="{Binding SelectedDevice}" ItemContainerStyle="{StaticResource NavigationItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PrimaryLabel}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentifierTooltip}"/><Border Grid.Column="1" Background="#EDF4F5" CornerRadius="4" Height="20" Width="24" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="{Binding ListNumber, StringFormat='终端序号 {0}'}"><TextBlock x:Name="DeviceNumberBadge" Text="{Binding ListNumber}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><TextBlock Text="{Binding GatewayStatus}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding Freshness}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="上行信息" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="终端上报 / 设置查询响应" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
          <Border x:Name="DeviceInformationCard" Grid.Row="1" Background="#E8EEF2" CornerRadius="7" Padding="12" Margin="0,12,0,12">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="终端信息" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="RegistrationStatusText" Grid.Column="1" Text="{Binding DeviceRegistrationStatus}" FontSize="11" Foreground="{Binding DeviceRegistrationColor}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
              <TextBlock x:Name="TerminalIdentityText" Text="{Binding SelectedSubtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <Grid x:Name="DeviceInformationFields"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                <TextBlock Text="硬件版本" Style="{StaticResource InformationLabel}" Margin="0,0,8,0"/><TextBlock x:Name="HardwareVersionText" Grid.Column="1" Text="{Binding DeviceHardwareVersion}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceHardwareVersion}" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="2" Text="应用版本" Style="{StaticResource InformationLabel}" Margin="0,0,8,0"/><TextBlock x:Name="AppVersionText" Grid.Column="3" Text="{Binding DeviceAppVersion}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceAppVersion}"/>
                <TextBlock Grid.Row="1" Text="WIoTa" Style="{StaticResource InformationLabel}" Margin="0,0,8,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceWiotaVersion}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceWiotaVersion}" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="SNR" Style="{StaticResource InformationLabel}" Margin="0,0,8,0"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DeviceSnr}" FontSize="12"/>
                <TextBlock Grid.Row="2" Text="上报周期" Style="{StaticResource InformationLabel}" Margin="0,0,8,0"/><TextBlock x:Name="DevicePeriodText" Grid.Row="2" Grid.Column="1" Text="{Binding DevicePeriod}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DevicePeriod}" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="信息接收" Style="{StaticResource InformationLabel}" Margin="0,0,8,0"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DeviceInformationTime}" FontSize="12"/>
              </Grid>
              <ScrollViewer Height="34" Margin="0,5,0,5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding DeviceConfigurationSummary}" ToolTip="{Binding ConfigurationDetails}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Top"/></ScrollViewer>
              <DockPanel><TextBlock Text="{Binding ReceiptTime}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Freshness}" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></DockPanel>
            </StackPanel>
          </Border>
          <TabControl Grid.Row="2" x:Name="DetailsTabs" Background="White" BorderThickness="0" SelectionChanged="UpstreamTabChanged">
            <TabItem Header="实时数据" Padding="10,8">
              <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,8,0">
                  <Border x:Name="AngleInformationCard" Background="#E2F1EC" CornerRadius="7" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                      <DockPanel><TextBlock Text="倾角信息" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="SensorStatusText" Text="{Binding SensorStatus}" FontSize="11" Foreground="{Binding SensorStatusColor}" HorizontalAlignment="Right"/></DockPanel>
                      <Grid x:Name="AngleLayout" SizeChanged="AngleLayoutChanged" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="AngleReadingColumn" Width="240"/><ColumnDefinition x:Name="AngleTrendColumn" Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:TiltInstrument X="{Binding AngleXValue}" Y="{Binding AngleYValue}" Height="122"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><DockPanel Margin="0,0,0,5"><TextBlock Text="X" Foreground="#2679C8" FontSize="15" Width="22"/><TextBlock Text="{Binding AngleX}" FontFamily="Segoe UI" FontSize="24"/></DockPanel><DockPanel Margin="0,0,0,5"><TextBlock Text="Y" Foreground="#C47B14" FontSize="15" Width="22"/><TextBlock Text="{Binding AngleY}" FontFamily="Segoe UI" FontSize="24"/></DockPanel><DockPanel><TextBlock Text="Z" Foreground="#8557BE" FontSize="15" Width="22"/><TextBlock Text="{Binding AngleZ}" FontFamily="Segoe UI" FontSize="24"/></DockPanel></StackPanel></Grid>
                        <Grid x:Name="AngleTrend" Grid.Column="1" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="156"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"><Run Text="倾角趋势"/><Run Text="{Binding TrendEmptyHint, Mode=OneWay}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Muted}"/></TextBlock><ComboBox Grid.Column="1" SelectedIndex="{Binding RangeIndex}" Width="118" FontSize="11"><ComboBoxItem Content="最近 5 分钟"/><ComboBoxItem Content="最近 30 分钟"/><ComboBoxItem Content="全部缓存"/></ComboBox></Grid><controls:TrendChart Grid.Row="1" Records="{Binding ChartRecords}" Minutes="{Binding ChartMinutes}" Margin="0,10,0,0"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"><TextBlock Text="● X" FontSize="11" Foreground="#2679C8" Margin="0,0,16,0"/><TextBlock Text="● Y" FontSize="11" Foreground="#C47B14" Margin="0,0,16,0"/><TextBlock Text="● Z" FontSize="11" Foreground="#8557BE"/></StackPanel></Grid>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border x:Name="GpsInformationCard" Background="#E4EFFA" CornerRadius="7" Padding="14" Margin="0,0,0,12"><StackPanel><DockPanel><TextBlock Text="GPS 信息" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="GnssStatusText" Text="{Binding GnssStatus}" FontSize="11" Foreground="{Binding GnssStatusColor}" HorizontalAlignment="Right"/></DockPanel><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="经度" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Longitude}" FontFamily="Segoe UI" FontSize="17" Margin="0,3,0,10"/><TextBlock Text="海拔" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Altitude}" FontSize="14" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="纬度" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Latitude}" FontFamily="Segoe UI" FontSize="17" Margin="0,3,0,10"/><TextBlock Text="HDOP" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Hdop}" FontSize="14" Margin="0,3,0,0"/></StackPanel></Grid></StackPanel></Border>
                  <Border x:Name="BatteryInformationCard" Background="#F5EED9" CornerRadius="7" Padding="14" Margin="0,0,0,12"><StackPanel><DockPanel><TextBlock Text="电池信息" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="BatteryStatusText" Text="{Binding BatteryStatus}" FontSize="11" Foreground="{Binding BatteryStatusColor}" HorizontalAlignment="Right"/></DockPanel><DockPanel Margin="0,10,0,0"><TextBlock Text="电池电压" Style="{StaticResource Caption}" Margin="0,0,16,0"/><TextBlock Text="{Binding Battery}" FontFamily="Segoe UI" FontSize="22" ToolTip="{Binding BatteryMillivolts}"/></DockPanel></StackPanel></Border>
                  <TextBlock Text="{Binding SampleTime}" FontSize="11" Foreground="{StaticResource Muted}" LineHeight="23" TextWrapping="Wrap"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="上行报文" Padding="10,8">
              <TabControl x:Name="UpstreamMessageTabs" SelectedIndex="1" Margin="0,4,0,0">
                <TabItem Header="网关交互报文" Padding="10,8">
                  <Grid x:Name="GatewayMessageLayout" Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="88"/><RowDefinition Height="48"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                    <DataGrid x:Name="GatewayMessagesGrid" ColumnHeaderHeight="34" ItemsSource="{Binding SelectedGateway.Messages}" SelectedItem="{Binding SelectedGatewayLog}" MouseDoubleClick="GatewayDetailClick" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="100" MinWidth="85"/><DataGridTextColumn Header="消息" Binding="{Binding Name}" Width="160" MinWidth="150"/><DataGridTextColumn Header="内容" Binding="{Binding Result}" Width="*" MinWidth="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding IdentifierTooltip}"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
                    <DockPanel Grid.Row="1" Margin="0,8"><Button Content="复制详情" Click="GatewayCopyClick" DockPanel.Dock="Right" Padding="10,5" MinHeight="28"/><TextBlock Text="当前网关的终端链路、在线事件及配置；心跳在网关列表统计。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,0"/></DockPanel>
                    <TextBox Grid.Row="2" Text="{Binding GatewayLogDetail, Mode=OneWay}" ToolTip="{Binding SelectedGatewayLog.IdentifierTooltip}" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"/>
                  </Grid>
                </TabItem>
            <TabItem Header="终端透传报文" Padding="10,8"><Grid x:Name="TerminalMessageLayout" Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="88"/><RowDefinition Height="48"/><RowDefinition Height="3*"/></Grid.RowDefinitions><DataGrid x:Name="TerminalMessagesGrid" ColumnHeaderHeight="34" ItemsSource="{Binding UpstreamView}" SelectedItem="{Binding SelectedLog}" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="100" MinWidth="85"/><DataGridTextColumn Header="消息" Binding="{Binding Name}" Width="*" MinWidth="100"/><DataGridTextColumn Header="类型" Binding="{Binding Direction}" Width="160" MinWidth="125"/><DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="100" MinWidth="85"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="1" Margin="0,8"><Button Content="复制详情" Click="CopyClick" DockPanel.Dock="Right" Padding="10,5" MinHeight="28"/><TextBlock Text="{Binding UpstreamCaption}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,0"/></DockPanel><TextBox Grid.Row="2" Text="{Binding LogDetail, Mode=OneWay}" ToolTip="{Binding SelectedLog.IdentifierTooltip}" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"/></Grid></TabItem>
              </TabControl>
            </TabItem>
            <TabItem Header="采样记录" Padding="10,8"><DockPanel Margin="0,10,0,0"><TextBlock DockPanel.Dock="Bottom" Text="显示最近 200 条采样记录。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,9"/><DataGrid ItemsSource="{Binding SampleRows}" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130"/><DataGridTextColumn Header="序号" Binding="{Binding Number}" Width="48"/><DataGridTextColumn Header="X / °" Binding="{Binding X}" Width="70"/><DataGridTextColumn Header="Y / °" Binding="{Binding Y}" Width="70"/><DataGridTextColumn Header="Z / °" Binding="{Binding Z}" Width="70"/><DataGridTextColumn Header="电压 / V" Binding="{Binding Battery}" Width="75"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*" MinWidth="100"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
          </TabControl>
        </Grid>
      </Border>
      <Border Grid.Column="6" Style="{StaticResource Panel}" Padding="14"><controls:ControlPanel x:Name="DownlinkPanel"/></Border>
    </Grid>
    <Border Grid.Row="2" Background="#EAF0F3" Padding="16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><TextBlock Grid.Column="1" Text="{Binding Counters}" FontSize="11" Foreground="{StaticResource Muted}"/></Grid></Border>
  </Grid>
</Window>
